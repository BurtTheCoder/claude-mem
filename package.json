{
  "name": "claude-mem",
  "version": "8.0.0",
  "description": "Memory system for Claude Code - persist context across sessions",
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "memory",
    "sqlite",
    "embeddings",
    "semantic-search",
    "typescript"
  ],
  "author": "Alex Newman",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thedotmack/claude-mem.git"
  },
  "homepage": "https://github.com/thedotmack/claude-mem#readme",
  "bugs": {
    "url": "https://github.com/thedotmack/claude-mem/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build-hooks.js",
    "test": "vitest",
    "test:memory": "npx tsx src/core/SimpleMemory.test.ts",
    "test:context": "echo '{\"session_id\":\"test-'$(date +%s)'\",\"cwd\":\"'$(pwd)'\",\"source\":\"startup\"}' | node plugin/scripts/context-hook.js 2>/dev/null",
    "test:context:verbose": "echo '{\"session_id\":\"test-'$(date +%s)'\",\"cwd\":\"'$(pwd)'\",\"source\":\"startup\"}' | node plugin/scripts/context-hook.js",
    "sync-marketplace": "node scripts/sync-marketplace.cjs",
    "sync-marketplace:force": "node scripts/sync-marketplace.cjs --force",
    "setup:model": "node scripts/setup-model.js",
    "migrate:simple": "node scripts/migrate-to-simple.js",
    "viewer": "npx tsx src/services/viewer-server.ts"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "better-sqlite3": "^12.5.0",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-lembed": "^0.0.1-alpha.8",
    "sqlite-vec": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  }
}
